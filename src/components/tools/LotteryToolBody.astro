---
/**
 * Everything between Lodavo's header and footer for the lottery calculator.
 * To port: render this inside the site's own Layout (see README, "Porting").
 * Markup and classes follow /en-ca/tools/compound-interest-calculator as shipped on 2026-11-14.
 */
import LotteryCalculator from '../LotteryCalculator.tsx';
import gamesData from '../../data/games.json';
import { COPY, CONFIG, type Locale } from '../../i18n/lottery';
import { makeFormat } from '../../lib/format';

interface Props { locale: Locale; linkOrigin?: string }
const { locale, linkOrigin = '' } = Astro.props;
const c = COPY[locale];
const cfg = CONFIG[locale];
const f = makeFormat(cfg.intl, cfg.currency);
const isFr = locale === 'fr-ca';
const site = (path: string) => (path.startsWith('http') ? path : path.includes('/lottery-calculator') || path.includes('/calculateur-loterie') ? path : linkOrigin + path);
const games = gamesData.games.filter((g) => cfg.games.includes(g.id));
const support = gamesData.support[locale];
const dayFr: Record<string, string> = { Monday: 'lundi', Tuesday: 'mardi', Wednesday: 'mercredi', Thursday: 'jeudi', Friday: 'vendredi', Saturday: 'samedi', Sunday: 'dimanche' };
const days = (d: string[]) => (isFr ? d.map((x) => dayFr[x]).join(', ') : d.join(', '));
const dateFmt = new Intl.DateTimeFormat(cfg.intl, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const checked = (iso: string) => dateFmt.format(new Date(iso + 'T00:00:00Z'));
const chevron = 'M13.1717 12.0007L8.22192 7.05093L9.63614 5.63672L16.0001 12.0007L9.63614 18.3646L8.22192 16.9504L13.1717 12.0007Z';
---
<section class="under-nav stage-deep grain relative overflow-hidden text-white">
  <div class="relative z-10 mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="caps text-xs text-white/70">{c.hero.eyebrow}</p>
    <h1 class="mt-3 text-balance text-4xl font-black tracking-tight sm:text-5xl">{c.hero.h1}</h1>
    <p class="mt-4 text-lg leading-relaxed text-white/80">{c.hero.intro}</p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <LotteryCalculator client:load locale={locale} />
</section>

<div class="mx-auto max-w-3xl px-4 pb-4 sm:px-6">
  <section>
    <h2 class="text-2xl font-black tracking-tight text-ink sm:text-3xl">{c.methodology.title}</h2>
    <span class="mt-3 block h-1 w-12 rounded-full bg-brand"></span>
    <div class="mt-5 space-y-4 text-pretty leading-relaxed text-ink/75">
      {c.methodology.body.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-black tracking-tight text-ink sm:text-3xl">{c.faqTitle}</h2>
    <span class="mt-3 block h-1 w-12 rounded-full bg-brand"></span>
    <div class="mt-6 space-y-5">
      {c.faqs.map((q) => (
        <div class="rounded-2xl bg-white p-5 shadow-sm sm:p-6">
          <h3 class="font-bold text-ink">{q.q}</h3>
          <p class="mt-2 text-pretty text-sm leading-relaxed text-ink/75">{q.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-black tracking-tight text-ink sm:text-3xl">{c.sources.title}</h2>
    <span class="mt-3 block h-1 w-12 rounded-full bg-brand"></span>
    <p class="mt-5 text-pretty leading-relaxed text-ink/75">{c.sources.intro}</p>
    <ul class="mt-6 space-y-4">
      {games.map((g) => (
        <li class="rounded-2xl bg-white p-5 shadow-sm sm:p-6">
          <h3 class="font-bold text-ink">{isFr ? g.name_fr : g.name}</h3>
          <dl class="nums mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
            <dt class="text-ink/65">{c.sources.thPrice}</dt><dd class="font-semibold text-ink">{f.price(g.price_per_play)} {c.sources.perPlay}</dd>
            <dt class="text-ink/65">{c.sources.thOdds}</dt><dd class="font-semibold text-ink">{isFr ? '1 sur' : '1 in'} {f.int(g.jackpot_odds)}</dd>
            <dt class="text-ink/65">{c.sources.thDraws}</dt><dd class="font-semibold text-ink">{c.sources.perWeek(g.draws_per_week)} ({days(g.draw_days)})</dd>
            <dt class="text-ink/65">{c.sources.thSource}</dt>
            <dd><ul class="space-y-1">{g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener" class="inline-block py-1 font-medium text-brand underline">{s.label}</a></li>)}</ul></dd>
            <dt class="text-ink/65">{c.sources.verified}</dt><dd class="text-ink/80"><time datetime={g.verified_on}>{checked(g.verified_on)}</time></dd>
          </dl>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="caps text-xs text-brand">{c.related}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {cfg.related.map((r) => (
        <li>
          <a href={site(r.href)} class="group flex h-full items-center justify-between gap-3 rounded-2xl border border-black/5 bg-white p-4 shadow-sm transition hover:border-brand/20 hover:shadow-md">
            <span class="text-sm font-semibold text-ink/85 transition group-hover:text-brand">{r.label}</span>
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0 text-ink/25 transition group-hover:translate-x-0.5 group-hover:text-brand" aria-hidden="true"><path d={chevron}></path></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>
</div>

<div class="mx-auto max-w-5xl px-4 sm:px-6">
  <section class="stage-deep grain relative my-12 overflow-hidden rounded-3xl px-6 py-10 text-white sm:px-10 sm:py-12" data-lottery-bridge data-locale={locale}>
    <div class="relative z-10 mx-auto max-w-2xl text-center">
      <p class="caps text-[0.7rem] text-accent">{c.bridge.eyebrow}</p>
      <h2 class="mt-3 text-balance text-2xl font-extrabold tracking-tight sm:text-3xl">{c.bridge.title}</h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty text-white/80">{c.bridge.why}</p>
      <ul class="mx-auto mt-6 max-w-xl space-y-2.5 text-left text-white/90">
        {c.bridge.lines.map((l) => (
          <li class="flex gap-3"><span class="mt-2 size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span><span class="text-pretty">{l}</span></li>
        ))}
      </ul>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={site(cfg.cta.href)} data-cta={cfg.cta.kind} data-placement="tool_bridge" class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-brand shadow-sm transition hover:brightness-95 active:scale-95">{c.bridge.cta}</a>
        {c.bridge.ctaAlt ? <a href={site(c.bridge.ctaAlt.href)} data-cta="secondary" data-placement="tool_bridge" class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">{c.bridge.ctaAlt.label}</a> : null}
      </div>
      <p class="mt-5"><a href={site(cfg.provablyFair)} data-cta="provably_fair" data-placement="tool_bridge" class="text-sm font-semibold text-accent underline underline-offset-4 transition hover:text-white">{c.bridge.fair}</a></p>
      <p class="mt-6 text-xs leading-relaxed text-white/70">
        {c.bridge.disclaimerBefore}{c.bridge.disclaimerLink && cfg.contestRules ? <a href={site(cfg.contestRules)} class="underline underline-offset-2 transition hover:text-white">{c.bridge.disclaimerLink}</a> : null}{c.bridge.disclaimerAfter}
      </p>
    </div>
  </section>

  <p class="mx-auto mb-4 max-w-2xl text-center text-xs leading-relaxed text-ink/65" data-gambling-support>
    {c.support.text}{' '}
    <a href={support.url} target="_blank" rel="noopener" class="font-medium text-brand underline">{support.label}</a>{'phone' in support ? <>{isFr ? ' : ' : ': '}<span class="nums whitespace-nowrap font-semibold text-ink/80">{support.phone}</span></> : null}
  </p>
</div>

<script>
  import { trackLotteryCtaClick } from '../../lib/analytics';
  // Pass the visitor's UTM params through to Lodavo CTAs, and report clicks.
  const bridge = document.querySelector<HTMLElement>('[data-lottery-bridge]');
  if (bridge) {
    const utm = [...new URLSearchParams(location.search)].filter(([k]) => k.startsWith('utm_'));
    bridge.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) => {
      if (utm.length) {
        const url = new URL(a.href, location.href);
        utm.forEach(([k, v]) => url.searchParams.set(k, v));
        a.href = url.toString();
      }
      a.addEventListener('click', () => {
        trackLotteryCtaClick({ locale: bridge.dataset.locale ?? '', kind: a.dataset.cta as any, placement: a.dataset.placement ?? '', href: a.href });
      });
    });
  }
</script>
