---
/**
 * Stand-in for Lodavo's own Layout.astro so this tool runs on its own.
 * Header and footer are a facsimile of lodavo.com (2026-11-14). Not needed after porting.
 */
import '../styles/global.css';
import { COPY, CONFIG, LOCALE_LIST, abs, type Locale } from '../i18n/lottery';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = COPY[locale];
const cfg = CONFIG[locale];
const O = 'https://www.lodavo.com';
const isFr = locale === 'fr-ca';
const us = locale === 'en-us';
const canonical = abs(cfg.path);
const ogImage = abs(`/og/lottery-calculator-${locale}.png`);
const nav = isFr
  ? [['Comment ça fonctionne', '/fr-ca#how-it-works'], ['Numéros gagnants', '/fr-ca/numeros-gagnants'], ['Vérification équitable', '/fr-ca/verification-equitable'], ['À propos', '/fr-ca/a-propos'], ['Apprendre', '/fr-ca/blogue']]
  : us
    ? [['How it works', '/en-us#how-it-works'], ['Provably fair', '/en-us/provably-fair'], ['About us', '/en-us/about-us'], ['Learn', '/en-us/blog']]
    : [['How it works', '/en-ca#how-it-works'], ['Winning numbers', '/en-ca/winning-numbers'], ['Provably fair', '/en-ca/provably-fair'], ['About us', '/en-ca/about-us'], ['Learn', '/en-ca/blog']];
const navCta = isFr ? 'Télécharger Lodavo' : us ? 'Join the waitlist' : 'Download Lodavo';
const foot = isFr
  ? { tag: 'Épargnez. Obtenez des billets. Gagnez des prix.', cols: [['Entreprise', [['À propos', '/fr-ca/a-propos'], ['Sécurité', '/fr-ca/securite'], ['Nous joindre', '/fr-ca/nous-joindre']]], ['Apprendre', [['Blogue', '/fr-ca/blogue'], ['Outils d’épargne', '/fr-ca/outils'], ['Normes éditoriales', '/fr-ca/normes-editoriales']]], ['Mentions légales', [['Conditions d’utilisation', '/fr-ca/conditions-dutilisation'], ['Politique de confidentialité', '/fr-ca/politique-de-confidentialite'], ['Règles du concours', '/fr-ca/regles-du-concours']]]], rights: '© 2026 Lodavo. Tous droits réservés.', lang: 'Langue et région' }
  : us
    ? { tag: 'Save money. Earn tickets. Win prizes.', cols: [['Company', [['About us', '/en-us/about-us'], ['Security', '/en-us/security'], ['Contact us', '/en-us/contact-us']]], ['Learn', [['Blog', '/en-us/blog'], ['Editorial standards', '/en-us/editorial-standards'], ['FAQ', '/en-us#faq']]], ['Legal', [['Privacy notice', '/en-us/privacy']]]], rights: '© 2026 Lodavo. All rights reserved.', lang: 'Language and region' }
    : { tag: 'Save money. Earn tickets. Win prizes.', cols: [['Company', [['About us', '/en-ca/about-us'], ['Security', '/en-ca/security'], ['Contact us', '/en-ca/contact-us']]], ['Learn', [['Blog', '/en-ca/blog'], ['Savings tools', '/en-ca/tools'], ['Editorial standards', '/en-ca/editorial-standards']]], ['Legal', [['Terms and Conditions', '/en-ca/terms-and-conditions'], ['Privacy Policy', '/en-ca/privacy-policy'], ['Contest Rules', '/en-ca/contest-rules']]]], rights: '© 2026 Lodavo. All rights reserved.', lang: 'Language and region' };
const langNames: Record<Locale, string> = { 'en-ca': 'Canada · English', 'fr-ca': 'Canada · Français', 'en-us': 'United States · English' };

const crumbs = [
  { name: 'Lodavo', item: abs(cfg.home) },
  ...(cfg.toolsHub ? [{ name: c.breadcrumbTools, item: abs(cfg.toolsHub) }] : []),
  { name: c.hero.h1, item: canonical },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${O}/#organization`, name: 'Lodavo', url: `${O}/`, logo: { '@type': 'ImageObject', url: `${O}/brand/lodavo-logo.png`, width: 512, height: 122 } },
    { '@type': 'WebSite', '@id': `${O}/#website`, url: `${O}/`, name: 'Lodavo', inLanguage: cfg.htmlLang, publisher: { '@id': `${O}/#organization` } },
    {
      '@type': 'WebApplication', '@id': `${canonical}#webapp`, name: c.hero.h1, url: canonical, description: c.meta.description,
      applicationCategory: 'FinanceApplication', operatingSystem: 'Web', browserRequirements: 'Requires JavaScript.', isAccessibleForFree: true,
      inLanguage: cfg.htmlLang, offers: { '@type': 'Offer', price: '0', priceCurrency: cfg.currency }, publisher: { '@id': `${O}/#organization` },
    },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, inLanguage: cfg.htmlLang, mainEntity: c.faqs.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.item })) },
  ],
};
---
<!doctype html>
<html lang={cfg.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="only light" />
    <link rel="canonical" href={canonical} />
    {LOCALE_LIST.map((l) => <link rel="alternate" hreflang={CONFIG[l].htmlLang} href={abs(CONFIG[l].path)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(CONFIG['en-ca'].path)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta property="og:site_name" content="Lodavo" />
    <meta property="og:locale" content={cfg.ogLocale} />
    {LOCALE_LIST.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={CONFIG[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={c.meta.ogAlt} />
    <meta name="twitter:site" content="@lodavo_ca" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-dvh flex-col" data-page-type="tool" data-lang={cfg.htmlLang}>
    <a href="#main" class="sr-only-focusable fixed top-2 left-2 z-50 rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand shadow-md">{isFr ? 'Aller au contenu' : 'Skip to content'}</a>
    <div class="orb-field" aria-hidden="true"></div>
    <header class="sticky top-0 z-40">
      <div class="mx-auto max-w-7xl px-4 pt-3 sm:px-6 sm:pt-4">
        <div class="nav-card relative rounded-2xl border border-black/5 bg-paper shadow-[0_10px_30px_-14px_rgba(2,0,31,0.25)]">
          <nav class="flex items-center justify-between gap-4 px-4 py-2.5 sm:px-5 lg:py-3.5" aria-label={isFr ? 'Principale' : 'Main'}>
            <a href={O + cfg.home} class="flex shrink-0 items-center gap-1.5" aria-label="Lodavo">
              <img src="/favicon.svg" alt="" width="36" height="36" class="size-9" />
              <span class="text-[1.7rem] leading-none font-medium tracking-tight text-brand">Lodavo</span>
            </a>
            <ul class="hidden items-center gap-7 lg:flex">
              {nav.map(([label, href]) => <li><a href={O + href} class="text-sm font-medium text-ink/75 transition hover:text-brand">{label}</a></li>)}
            </ul>
            <div class="flex items-center gap-2">
              <a href={O + cfg.cta.href} class="brand-gradient-r hidden rounded-full px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:scale-[1.03] hover:brightness-105 active:scale-95 sm:inline-flex">{navCta}</a>
              <button type="button" data-nav-open aria-controls="mobile-nav" aria-expanded="false" aria-label="Menu" class="-mr-2 flex items-center rounded-md p-2 text-ink/80 transition hover:text-brand lg:hidden">
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true"><path d="M3 4H21V6H3V4ZM3 11H21V13H3V11ZM3 18H21V20H3V18Z"></path></svg>
              </button>
            </div>
          </nav>
          <ul id="mobile-nav" hidden class="space-y-1 border-t border-black/5 px-4 py-3 lg:hidden">
            {nav.map(([label, href]) => <li><a href={O + href} class="block rounded-xl px-3 py-2.5 text-base font-medium text-ink/80 transition hover:bg-ink/5 hover:text-brand">{label}</a></li>)}
            <li class="pt-2"><a href={O + cfg.cta.href} class="brand-gradient-r flex w-full items-center justify-center rounded-full px-6 py-3.5 text-base font-semibold text-white shadow-sm">{navCta}</a></li>
          </ul>
        </div>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="stage-deep grain relative mt-20 overflow-hidden text-white">
      <div class="relative z-10 mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
          <div>
            <p class="flex items-center gap-1.5"><img src="/favicon.svg" alt="" width="36" height="36" class="size-9 rounded-full ring-2 ring-white/30" /><span class="text-[1.7rem] leading-none font-medium tracking-tight">Lodavo</span></p>
            <p class="mt-4 max-w-xs text-sm text-white/75">{foot.tag}</p>
          </div>
          {foot.cols.map(([title, links]) => (
            <div>
              <h2 class="caps text-xs text-white/70">{title}</h2>
              <ul class="mt-4 space-y-2">{(links as string[][]).map(([label, href]) => <li><a href={O + href} class="text-sm text-white/80 transition hover:text-accent">{label}</a></li>)}</ul>
            </div>
          ))}
        </div>
        <div class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-white/70">{foot.rights}</p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2" aria-label={foot.lang}>
            {LOCALE_LIST.map((l) => <li><a href={CONFIG[l].path} hreflang={CONFIG[l].htmlLang} aria-current={l === locale ? 'page' : undefined} class={`text-sm transition hover:text-accent ${l === locale ? 'font-semibold text-white' : 'text-white/80'}`}>{langNames[l]}</a></li>)}
          </ul>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const b = document.querySelector('[data-nav-open]'), m = document.getElementById('mobile-nav');
        if (b && m) b.addEventListener('click', () => { const open = m.hidden; m.hidden = !open; b.setAttribute('aria-expanded', String(open)); });
      })();
    </script>
  </body>
</html>
